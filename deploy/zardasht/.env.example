# Toolshop deployment for the zardasht host.
# Copy this file to .env, replace every __...__ value, then: chmod 600 .env
#
# Image tags are the versioned tags produced by .github/workflows/release.yml.
APP_API_IMAGE=toolshop-api:1.0.0
APP_WEB_IMAGE=toolshop-web:1.0.0
APP_TOOLS_IMAGE=toolshop-api-tools:1.0.0

# Public origin. The wildcard certificate on the host covers *.zardasht-co.com;
# shop.155.117.234.45.sslip.io is the DNS-free fallback and gets its own
# Let's Encrypt certificate through Traefik.
APP_DOMAIN=shop.155.117.234.45.sslip.io
APP_PUBLIC_URL=https://shop.155.117.234.45.sslip.io
CORS_ORIGINS=https://shop.155.117.234.45.sslip.io

# These three values are baked into the web image at build time. Changing them
# requires rebuilding the web image, not just restarting the container.
NEXT_PUBLIC_SITE_URL=https://shop.155.117.234.45.sslip.io
API_INTERNAL_URL=http://api:4000
STORAGE_PUBLIC_BASE_URL=/uploads

# One Traefik hop and one Next.js rewrite hop in front of the API.
TRUST_PROXY_HOPS=2
CATALOG_REVALIDATE_SECONDS=60
COOKIE_SECURE=true
COOKIE_DOMAIN=

# Shared PostgreSQL on the external `database` network.
APP_DB_NAME=toolshop
APP_DB_USER=toolshop
APP_DB_PASSWORD=__GENERATE_HEX_32__
DATABASE_URL=postgresql://toolshop:__GENERATE_HEX_32__@postgres:5432/toolshop?schema=public
DATABASE_POOL_SIZE=5

# Redis is shared infrastructure, not part of this compose project. Point this at
# the shared instance (the `redis` hostname assumes a container named `redis` on
# the external `database` network) or at any reachable Redis URL.
REDIS_URL=redis://:__REDIS_PASSWORD__@redis:6379/0

# Application secrets.
JWT_ACCESS_SECRET=__GENERATE_HEX_64__
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Generate 32 random bytes and base64-encode them.
APP_ENCRYPTION_KEY=__GENERATE_BASE64_32__

# Meilisearch is not deployed on this host. The API logs a warning and falls back
# to database search. MEILI_HOST must still be a valid URL and the key strong.
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=__GENERATE_HEX_32__
MEILI_INDEX_PREFIX=toolshop_

# Local uploads are stored under /srv/data/toolshop/uploads.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=8

# Demo checkout. A real shop needs a payment-provider adapter before this is
# turned off.
PAYMENT_DEFAULT_PROVIDER=mock
PAYMENT_ALLOW_MOCK_IN_PRODUCTION=true
STOCK_RESERVATION_TTL_MINUTES=20

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

QUEUE_WORKERS_ENABLED=true

# Demo seed. Change the password before running the seed; the seed creates the
# admin account plus sample products, orders and customers.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=__SET_A_STRONG_PASSWORD__

# Optional. Leave empty to keep AI and messenger features disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
AI_COMPAT_API_KEY=
TELEGRAM_API_BASE=
BALE_API_BASE=

NODE_ENV=production
LOG_LEVEL=info
API_PORT=4000
