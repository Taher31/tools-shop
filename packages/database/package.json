{
  "name": "@toolshop/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, seed and typed client for the toolshop database.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@toolshop/config": "workspace:*",
    "@toolshop/shared": "workspace:*",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
