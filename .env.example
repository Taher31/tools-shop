# =============================================================================
#  Toolshop – environment configuration
#  Copy to `.env` in the repository root. Every app (api, web, database) reads
#  this single file in development. In production inject real secrets through
#  your orchestrator instead of committing them.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------
POSTGRES_USER=toolshop
POSTGRES_PASSWORD=toolshop
POSTGRES_DB=toolshop
POSTGRES_PORT=5432
DATABASE_URL=postgresql://toolshop:toolshop@localhost:5432/toolshop?schema=public
# Connections per API process.
DATABASE_POOL_SIZE=10
# Used by the API integration tests (the database is reset by the test runner).
TEST_DATABASE_URL=postgresql://toolshop:toolshop@localhost:5432/toolshop_test?schema=public

# ----------------------------------------------------------------------------
# Redis (cache, rate limiting, BullMQ queues)
# ----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# Meilisearch
# ----------------------------------------------------------------------------
MEILI_PORT=7700
MEILI_HOST=http://localhost:7700
# At least 16 bytes. Generate with: openssl rand -base64 32
MEILI_MASTER_KEY=dev_master_key_change_me_0123456789
MEILI_INDEX_PREFIX=toolshop_

# ----------------------------------------------------------------------------
# API (NestJS)
# ----------------------------------------------------------------------------
API_PORT=4000
# Public origin of the storefront. Used for CORS/origin checks, payment callbacks
# and absolute URLs (SEO, e-mails).
APP_PUBLIC_URL=http://localhost:3000
# Extra origins allowed to call the API with credentials (comma separated).
CORS_ORIGINS=http://localhost:3000
# Reverse proxies in front of the API whose X-Forwarded-For is trusted (client IPs
# for rate limiting and audit logs). Locally the Next.js rewrite is one hop. Count
# every proxy in production (e.g. nginx -> Next.js = 2) and never expose the API
# port directly, otherwise clients could spoof their IP.
TRUST_PROXY_HOPS=1
# Run BullMQ workers (search indexing, order expiry, outbox relay) in this process.
# Set to false on extra web-only API replicas.
QUEUE_WORKERS_ENABLED=true

# Auth – generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_characters_long
# Access token lifetime in seconds.
JWT_ACCESS_TTL_SECONDS=900
# Refresh token (rotating, stored hashed in the database) lifetime in days.
REFRESH_TOKEN_TTL_DAYS=30
# `true` behind HTTPS (production). Must be `false` on plain http://localhost.
COOKIE_SECURE=false
# Leave empty for host-only cookies.
COOKIE_DOMAIN=

# 32-byte key (base64) for encrypting secrets at rest (integration credentials,
# AI provider keys). Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=ZGV2X2VuY3J5cHRpb25fa2V5X2NoYW5nZV9tZV8zMmI=

# Rate limiting (requests per window, per client IP)
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ----------------------------------------------------------------------------
# File storage
# ----------------------------------------------------------------------------
# `local` (development) or `s3` (any S3-compatible storage: AWS, MinIO, ArvanCloud…)
STORAGE_DRIVER=local
# Directory for the local driver, relative to apps/api.
STORAGE_LOCAL_DIR=uploads
# Public URL prefix for stored files. Locally the web app proxies /uploads to the API.
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/uploads
MAX_UPLOAD_SIZE_MB=8

S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ----------------------------------------------------------------------------
# Checkout & payments
# ----------------------------------------------------------------------------
# Provider used for new payments. Only `mock` exists until a real PSP adapter is added.
PAYMENT_DEFAULT_PROVIDER=mock
# The mock gateway is refused when NODE_ENV=production unless this is true (staging only).
PAYMENT_ALLOW_MOCK_IN_PRODUCTION=false
# Minutes an unpaid order keeps its stock reserved before it is cancelled.
STOCK_RESERVATION_TTL_MINUTES=20

# ----------------------------------------------------------------------------
# Web (Next.js)
# ----------------------------------------------------------------------------
WEB_PORT=3000
# How the Next.js server reaches the API (server-side fetches and /api rewrites).
API_INTERNAL_URL=http://localhost:4000
# Public site URL baked into the client bundle (canonical URLs, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Seconds catalog pages are cached before revalidation (ISR).
CATALOG_REVALIDATE_SECONDS=60

# ----------------------------------------------------------------------------
# Seed
# ----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345

# --- AI (Phase 3) -----------------------------------------------------------
# Optional: the key is normally entered (encrypted) in Admin → AI Center. This is
# only a fallback when no key is stored there. Never expose it to the web app.
ANTHROPIC_API_KEY=
# Optional override for a gateway in front of the Anthropic API.
ANTHROPIC_BASE_URL=
# Messenger bots: override the Bot API base, e.g. a self-hosted Telegram Bot API
# server or a relay when api.telegram.org is not reachable from the server.
TELEGRAM_API_BASE=
BALE_API_BASE=
